class JinS:
	c=[]
	def __init__(self,J,S):
		self.J=J
		self.S=S

	def jins(self):
		for i in range(len(self.J)):
			self.c.append(0)
			for j in range(len(self.S)):	
				if(self.J[i]==self.S[j]):
					self.c[i]+=1
	
	def display(self):
		print(self.c)

J=input("Enter string for unique values for Jewels")
S=input("Enter string for stones you have")
ob=JinS(J,S)
ob.jins()
ob.display()			

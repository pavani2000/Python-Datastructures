# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, x):
#         self.val = x
#         self.left = None
#         self.right = None

class Solution:
    answer=[]
    stack1=[]
    answerreverse=[]
    def postorderTraversal(self, root: TreeNode) -> List[int]:
        if(root==None):
            return()
        self.stack1.append(root)
        while(len(self.stack1)!=0):
            temp=self.stack1.pop()
            self.answerreverse.append(temp.val)
            if(temp.left!=None):
                self.stack1.append(temp.left)
            if(temp.right!=None):
                self.stack1.append(temp.right)
        n=len(self.answerreverse)
        for i in range(n):
            self.answer.append(self.answerreverse.pop())
        return self.answer

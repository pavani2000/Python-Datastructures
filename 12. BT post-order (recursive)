# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, x):
#         self.val = x
#         self.left = None
#         self.right = None

class Solution:
    elements=[]
    def postorderTraversal(self, root: TreeNode) -> List[int]:
        if(root==None):
            return ()
        if(root.left!=None):
            self.postorderTraversal(root.left)
        if(root.right!=None):
            self.postorderTraversal(root.right)
        self.elements.append(root.val) 
        return self.elements

# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, x):
#         self.val = x
#         self.left = None
#         self.right = None

class Solution:
    stack=[]
    answer=[]
    def inorderTraversal(self, root: TreeNode) -> List[int]:
        if(root==None):
            return ()
        current=root
        while(True):
            while(current!=None):
                self.stack.append(current)
                current=current.left
            current=self.stack.pop()
            self.answer.append(current.val)
            current=current.right
            if(self.stack==[] and current==None):
                break
        return self.answer

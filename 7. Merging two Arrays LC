class Solution:
	def merge(self, nums1, m, nums2, n):
		k=0;i=0;j=0
		while(i<m and j<n):
			if(nums1[i+k]>=nums2[j]): 	
				nums1=nums1[0:i]+[nums2[j]]+nums1[i:m+n-k-1]
				j+=1
				k+=1
			else:
				i+=1
		while(j<n):
			nums1[i+k]=nums2[j]
			k+=1;j+=1
		return nums1


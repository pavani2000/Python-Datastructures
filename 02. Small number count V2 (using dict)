class Solution:   						#successful in LeetCode
	def __init__(self,l,n):
		self.l=l
		self.a=['']*n
		self.n=n

	def computes(self):
		dict1={self.l[i]:i for i in range(n)}
		c=0
		k=''
		for i in sorted(self.l):
			if(i!=k):	
				self.a[dict1[i]]=c
			c+=1
			k=i
		for j in range(self.n):
			if(self.a[j]==''):
				self.a[j]=self.a[dict1[l[j]]]

		return(self.a)



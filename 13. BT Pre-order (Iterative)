# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, x):
#         self.val = x
#         self.left = None
#         self.right = None

class Solution:
    stack=[]
    answer=[]
    def preorderTraversal(self, root: TreeNode) -> List[int]:
        if(root==None):
            return ()
        self.stack.append(root)
        while(len(self.stack)!=0):
            new=self.stack.pop()
            self.answer.append(new.val)
            if(new.right!=None):
                self.stack.append(new.right)
            if(new.left!=None):
                self.stack.append(new.left)
        return self.answer

# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, x):
#         self.val = x
#         self.left = None
#         self.right = None

class Solution:
    elements=[]
    def inorderTraversal(self, root: TreeNode) -> List[int]:
        if(root==None):
            return ()
        if(root.left!=None):
            self.inorderTraversal(root.left)
        self.elements.append(root.val)
        if(root.right!=None):
            self.inorderTraversal(root.right)
        return self.elements
